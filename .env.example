# Anthropic API Key - in Vercel unter Settings > Environment Variables hinterlegen
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Modelle überschreiben.
# Default ist Claude Sonnet 5 (2 $/10 $ je Mio. Token).
# ANTHROPIC_MODEL=claude-sonnet-5
#
# Nur für die Gespräche - der häufigste Aufruf im Spiel.
# claude-haiku-4-5 ist am günstigsten (1 $/5 $), claude-opus-5 am stärksten.
# ANTHROPIC_MODEL_TALK=claude-haiku-4-5

# Optional: eigener Schlüssel zum Verschlüsseln des Falls
# CASE_SECRET=langer-zufallsstring
